<?php
require_once 'fare_engine.php';

$input = array_merge($_GET, $_POST, fare_input());
$action = strtolower(fare_get_string($input, 'action', 'list'));
$rideCodeRaw = fare_get_string($input, 'ride_code', '');
$rideCode = preg_replace('/[^A-Za-z0-9\-_]/', '', $rideCodeRaw);
if ($rideCode === '') {
    fare_json(['ok' => false, 'error' => 'ride_code_required'], 422);
}

$role = strtolower(fare_get_string($input, 'role', 'passenger'));
if (!in_array($role, ['passenger', 'driver'], true)) $role = 'passenger';
$sender = fare_get_string($input, 'sender', $role === 'driver' ? 'Driver' : 'Passenger');

$dir = __DIR__ . DIRECTORY_SEPARATOR . 'uploads' . DIRECTORY_SEPARATOR . 'chat_logs';
if (!is_dir($dir)) {
    @mkdir($dir, 0777, true);
}
$file = $dir . DIRECTORY_SEPARATOR . 'chat_' . $rideCode . '.json';

function chat_read_rows(string $file): array {
    if (!file_exists($file)) return [];
    $raw = @file_get_contents($file);
    if ($raw === false || trim($raw) === '') return [];
    $json = json_decode($raw, true);
    return is_array($json) ? $json : [];
}

function chat_write_rows(string $file, array $rows): bool {
    return @file_put_contents($file, json_encode($rows, JSON_UNESCAPED_UNICODE), LOCK_EX) !== false;
}

if ($action === 'send') {
    $message = trim((string)($input['message'] ?? ''));
    if ($message === '') {
        fare_json(['ok' => false, 'error' => 'message_required'], 422);
    }
    $rows = chat_read_rows($file);
    $rows[] = [
        'id' => 'm-' . bin2hex(random_bytes(6)),
        'ride_code' => $rideCode,
        'role' => $role,
        'sender' => $sender,
        'message' => $message,
        'created_at' => date('c')
    ];
    if (count($rows) > 400) {
        $rows = array_slice($rows, -400);
    }
    if (!chat_write_rows($file, $rows)) {
        fare_json(['ok' => false, 'error' => 'write_failed'], 500);
    }
    fare_json(['ok' => true, 'message' => end($rows)]);
}

$since = fare_get_string($input, 'since', '');
$rows = chat_read_rows($file);
if ($since !== '') {
    $rows = array_values(array_filter($rows, static function ($row) use ($since) {
        return isset($row['created_at']) && strcmp((string)$row['created_at'], $since) > 0;
    }));
}
fare_json([
    'ok' => true,
    'ride_code' => $rideCode,
    'messages' => $rows
]);

